--=====================================================================
--  QoL  (anti-afk / perf / raccourcis)
--=====================================================================
-- Anti-kick : bloque uniquement les :Kick() venant du cote client
-- **impossible de bloquer le kick serveur (BAC-2513 / Error 267)**
-- la vraie solution est MoveMode = "walk" pour ne pas etre detecte a la source
local function installAntiKick()
    if not CFG.AntiKick then return end
    local g = getgenv()
    if g.__egg_antikick then return end
    local ok = pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local m = getnamecallmethod()
            if m == "Kick" and typeof(self) == "Instance" and self:IsA("Player") then
                warn("[Egg] Kick cote client bloque : " .. tostring((...)):sub(1, 60))
                return nil
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
    end)
    g.__egg_antikick = ok
    log("anti-kick", ok and "installe (cote client uniquement)" or "ECHEC")
end

local function setupQoL()
    installAntiKick()

    if CFG.AntiAFK then
        local ok, vu = pcall(function() return game:GetService("VirtualUser") end)
        if ok and vu then
            track(LP.Idled:Connect(function()
                pcall(function()
                    vu:CaptureController()
                    vu:ClickButton2(Vector2.new(0, 0))
                end)
            end))
        end
    end

    if CFG.FpsBoost then pcall(function() setfpscap(CFG.FpsCap) end) end

    if CFG.PerfMode then
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 1e6
            for _, d in ipairs(Lighting:GetChildren()) do
                if d:IsA("PostEffect") then d.Enabled = false end
            end
        end)
    end

    local UIS = game:GetService("UserInputService")
    track(UIS.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Enum.KeyCode.F2 then
            S.paused = not S.paused
            log(S.paused and "en pause" or "relance")
        elseif input.KeyCode == Enum.KeyCode.F3 then
            _G.EggMode()
        elseif input.KeyCode == Enum.KeyCode.F4 then
            if S.ui and S.ui.frame then S.ui.frame.Visible = not S.ui.frame.Visible end
        end
    end))
end

--=====================================================================
--  SECURITE  (eviter la mort - ce jeu ne respawn pas, il faut sortir et rentrer)
--=====================================================================
local function guardCharacter(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    pcall(function()
        -- desactive les etats qui infligent des degats de chute
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    end)
end

local function isDead()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health <= 0
end

-- tentative de respawn : fire le remote de reset puis attend le CharacterAdded
local function reviveIfDead()
    if not isDead() then return true end

    -- mort en humtween = trop rapide, baisse la vitesse seul pour ne pas re-mourir
    if CFG.MoveMode == "humtween" then
        pcall(function() M.humRestore() end)
        if (tonumber(CFG.HumTweenSpeed) or 0) > 0 then
            -- vitesse constante -> coupee en deux, sous 120 on arrete la vitesse constante
            CFG.HumTweenSpeed = math.floor(CFG.HumTweenSpeed / 2)
            if CFG.HumTweenSpeed < 120 then CFG.HumTweenSpeed = 0 end
            warn(("[Egg] mort en humtween - HumTweenSpeed reduit a %d (0 = lie a la WalkSpeed)")
                :format(CFG.HumTweenSpeed))
        elseif (CFG.HumTweenSpeedMul or 2) > 1 then
            CFG.HumTweenSpeedMul = math.max(1, (CFG.HumTweenSpeedMul or 2) - 0.5)
            warn(("[Egg] mort en humtween - HumTweenSpeedMul reduit a %.1f")
                :format(CFG.HumTweenSpeedMul))
        else
            CFG.MoveMode = M.fallbackMode()
            warn("[Egg] mort meme en humtween 1x - bascule en mode " .. CFG.MoveMode .. " definitif")
        end
    elseif CFG.MoveMode == "tween" then
        if (CFG.TweenSpeedMul or 1) > 1 then
            CFG.TweenSpeedMul = math.max(1, (CFG.TweenSpeedMul or 1) - 0.5)
            warn(("[Egg] mort en tween - TweenSpeedMul reduit a %.1f"):format(CFG.TweenSpeedMul))
        else
            CFG.MoveMode = "walk"
            warn("[Egg] mort meme en tween 1x - bascule en mode walk definitif")
        end
    end
    pcall(function() M.unlock() end)

    S.status = "mort - tentative de respawn"
    warn("[Egg] personnage mort - demande de respawn (si rien en 30s, quitter et reentrer)")
    -- v447 : RE/RigSync/AskRigWipe n'est plus une "demande de respawn"
    -- le jeu le fire depuis Humanoid.Died comme une "notification de mort" avec le model en argument
    -- le fire en boucle ne ressuscitera donc rien et c'est un comportement bizarre pour le serveur -> on ne fire plus
    -- ce jeu morte = il faut sortir et reentrer, on attend juste au cas ou CharacterAutoLoads travaille
    local t0 = os.clock()
    while S.alive and os.clock() - t0 < 30 do
        task.wait(0.5)
        if not isDead() then
            guardCharacter(LP.Character)
            log("respawn ok")
            return true
        end
    end
    warn("[Egg] pas de respawn - il faut quitter et reentrer dans le jeu")
    return false
end

--=====================================================================
--  BOUCLE PRINCIPALE
--=====================================================================
local function tendBase()
    S.status = "travail a la base"
    M.goHome()
    B.placeEggs()
    B.hatchReady()
    B.equipAndSell()
    B.upgrade()
end

local function cycle()
    S.loops = S.loops + 1

    if handleReset() then return end

    -- 1) on regarde d'abord s'il y a des oeufs a ramasser  <<< collecte prioritaire
    local pets = B.myPets()
    local ownedBest = pets[1] and pets[1].mps or 0
    local list = A.candidates(ownedBest)

    -- aucun oeuf dans les zones accessibles
    if #list == 0 then
        -- trop lent pour les bonnes zones -> pomper la Speed
        -- (la zone facile est toujours accessible, si on arrive ici c'est que ses oeufs sont epuises)
        if CFG.CollectFirst and tooSlowToSteal() then
            S.status = string.format("attente d'oeufs / trop lent (walk %.0f) - entrainement", U.walkSpeed())
        else
            S.status = "aucun oeuf disponible - attente"
        end
        tendBase()
        if CFG.RideTreadmill and S.tread and tooSlowToSteal() then
            rideTreadmill(CFG.TreadmillSeconds)
        else
            task.wait(3)
        end
        return
    end

    if CFG.Verbose then
        local top = {}
        for i = 1, math.min(3, #list) do
            top[#top + 1] = string.format("%s %s/s", list[i].rec.AssetCategory, U.short(list[i].value))
        end
        log(("%d oeufs valent le coup | meilleurs : %s"):format(#list, table.concat(top, " > ")))
    end

    -- vol un par un, relit la liste a chaque fois
    -- (un oeuf de l'ancienne liste a pu etre pris par quelqu'un d'autre, pas la peine d'y courir)
    local grabbed, tried = 0, {}
    while grabbed < math.max(1, CFG.ChainGrab) do
        if not S.alive or S.paused or S.resetting then break end

        local cand
        for _, c in ipairs(list) do
            if not tried[c.rec.Uid] then cand = c break end
        end
        if not cand then break end
        tried[cand.rec.Uid] = true

        if stealEgg(cand) then
            if carryHome() then
                grabbed = grabbed + 1
            else
                log("claim timeout - retour au travail de base")
                break
            end
        end

        if grabbed < math.max(1, CFG.ChainGrab) then
            list = A.candidates(ownedBest)
            if #list == 0 then break end
        end
        task.wait(0.1)
    end

    -- 2) travail a la base
    if grabbed > 0 or (S.loops % math.max(1, CFG.TendEvery) == 0) then
        tendBase()
    end

    -- 3) pomper la Speed
    treadmillIfNeeded()

    task.wait(CFG.LoopDelay)
end

