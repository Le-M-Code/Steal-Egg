--  BOOT
--=====================================================================
function _G.EggStop()
    S.alive = false
    _G.__EGG_RUNNING = false
    pcall(function() M.humRestore() end)        -- rend la vraie WalkSpeed sinon le joueur ne marche plus
    pcall(function() M.releaseControls() end)   -- rend le controle au joueur
    pcall(function() M.unlock() end)            -- jamais laisser le corps en mode anchor
    for _, c in ipairs(S.conns) do pcall(function() c:Disconnect() end) end
    S.conns = {}
    if S.ui and S.ui.gui then pcall(function() S.ui.gui:Destroy() end) end
    print("[Egg] arrete")
end

function _G.EggPause(v)
    if v == nil then S.paused = not S.paused else S.paused = v and true or false end
    return S.paused
end

-- demarrer/reprendre  (le bouton START du panneau appelle ceci)
function _G.EggStart()
    S.paused = false
    return true
end

-- change de mode de deplacement  sans argument = suivant, avec nom = fixe direct
function _G.EggMode(mode)
    local order = { "humtween", "walk", "tween" }
    if mode then
        local want = tostring(mode):lower()
        -- nom de mode invalide = tombe en humtween en silence via goTo, ce qui n'est pas le souhait de l'user
        if want ~= "humtween" and want ~= "walk" and want ~= "tween" and want ~= "warp" then
            warn('[Egg] mode inconnu "' .. want .. '" - utilisables : humtween / walk / tween / warp')
            return CFG.MoveMode
        end
        CFG.MoveMode = want
    else
        local i = 1
        for n, m in ipairs(order) do if m == CFG.MoveMode then i = n break end end
        CFG.MoveMode = order[(i % #order) + 1]
    end
    pcall(function() M.humRestore() end)
    log("mode de deplacement ->", CFG.MoveMode)
    return CFG.MoveMode
end

-- modifie la config a chaud en pleine execution, ex _G.EggSet{ ChainGrab = 8, HumTweenSpeed = 450 }
function _G.EggSet(tbl)
    for k, v in pairs(tbl or {}) do CFG[k] = v end
    return CFG
end

-- deplace le personnage vers un point avec le meme mover que la farm (test/usage manuel)
function _G.EggGoTo(pos, tol)
    if typeof(pos) == "CFrame" then pos = pos.Position end
    return M.goTo(pos, tol or 5)
end

-- rend le controle du personnage immediatement (si le script est bloque et qu'on ne marche plus)
function _G.EggRelease()
    pcall(function() M.humRestore() end)
    pcall(function() M.unlock() end)
    pcall(function() M.releaseControls() end)
    return true
end

local function boot()
    repeat task.wait() until game:IsLoaded()
    task.wait(1)

    buildUI()
    setupQoL()
    wireEvents()

    guardCharacter(LP.Character)
    track(LP.CharacterAdded:Connect(function(c)
        task.wait(0.5)
        guardCharacter(c)
    end))

    -- attend de trouver notre plot (apres un changement de serveur le numero de slot change)
    local t0 = os.clock()
    while S.alive and not resolvePlot() and os.clock() - t0 < 45 do
        S.status = "attente du plot"
        updateUI()
        task.wait(1)
    end
    if not S.plot then
        warn("[Egg] plot introuvable - arret")
        _G.EggStop()
        return
    end
    log("plot", S.plot.Name, "| enclos", tostring(S.pen and S.pen.Position))

    B.claimOffline()

    -- nettoie ce qui traine de la session precedente
    tendBase()

    -- reprend tout seul apres un changement de serveur
    if CFG.SurviveTeleport and CFG.SourceUrl then
        pcall(function()
            queue_on_teleport(([[
                _G.EggConfig = game:GetService("HttpService"):JSONDecode(%q)
                loadstring(game:HttpGet(%q))()
            ]]):format(game:GetService("HttpService"):JSONEncode({
                Area = CFG.Area, ChainGrab = CFG.ChainGrab, KeepAbove = tostring(CFG.KeepAbove),
                MinEggRate = tostring(CFG.MinEggRate), AutoSell = CFG.AutoSell, AutoHatch = CFG.AutoHatch,
            }), CFG.SourceUrl))
        end)
    end

    -- boucle UI
    spawnLoop(function()
        updateUI()
        task.wait(0.35)
    end)

    -- boucle principale
    spawnLoop(function()
        if S.paused then
            S.status = "pause"
            task.wait(0.5)
            return
        end
        if isDead() then
            if not reviveIfDead() then
                S.status = "mort - rejoin obligatoire"
                task.wait(5)
            end
            return
        end
        if not U.char() then
            S.status = "attente du personnage"
            task.wait(1)
            return
        end
        if not S.plot or not S.plot.Parent then
            resolvePlot()
            task.wait(1)
            return
        end
        cycle()
    end)

    log(("demarre | preset %s | mode %s | F2 pause  F3 mode  F4 masquer")
        :format(tostring(CFG.Preset), tostring(CFG.MoveMode)))
    log("commandes : _G.EggStart() _G.EggPause() _G.EggMode() _G.EggSet{} _G.EggRelease() _G.EggStop()")
end

task.spawn(boot)
